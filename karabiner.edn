{;; Key modifier definitions (used throughout configuration)
 ;; !  = mandatory modifier (must be pressed)
 ;; #  = optional modifier (can be present or not)
 ;; C  = left_command   (⌘)
 ;; T  = left_control   (⌃)
 ;; O  = left_option    (⌥)
 ;; S  = left_shift     (⇧)
 ;; F  = fn             (Fn)
 ;; Q  = right_command  (right ⌘)
 ;; W  = right_control  (right ⌃)
 ;; E  = right_option   (right ⌥)
 ;; R  = right_shift    (right ⇧)
 ;; P  = caps_lock      (⇪)
 ;; !! = Hyper key = right_command+right_control+right_option+right_shift (🪄)
 ;; ## = Any combination of modifiers (including none)

 :profiles {:KapsLite {;; "default true means" rules default goes into this rule if no profiles specified
                       :default true

                       ;; simultaneous key press threshold
                       :sim     250

                       ;; to_delayed_action_delay_milliseconds
                       :delay   500

                       ;; to_if_alone_timeout_milliseconds
                       :alone   500

                       ;; to_if_held_down_threshold_milliseconds
                       :held    200}}

 ;; Threshold for detecting simultaneous layer activation
 :simlayer-threshold 250

 ;; MAIN KEY MAPPING CONFIGURATION
 :main [;; ===== CapsLock Transformation ================================
        {:des "Capslock -> Hyper"
         :lazy true
         :rules [[:##caps_lock
                  :!QWEright_shift
                  nil
                  {:alone [{:key :caps_lock
                            :hold_down_milliseconds 100}]}]]}

        ;; ===== Cursor Movement Layer ================================
        {:des   "Hyper-based cursor movement"
         :rules [;; Basic cursor movement
                 [:!QWERe :up_arrow]       ;; Caps + E → ↑
                 [:!QWERd :down_arrow]     ;; Caps + D → ↓
                 [:!QWERs :left_arrow]     ;; Caps + S → ←
                 [:!QWERf :right_arrow]    ;; Caps + F → →

                 ;; Word navigation
                 [:!QWERCs :!Oleft_arrow]   ;; Caps + Cmd + S → ⌥←
                 [:!QWERCf :!Oright_arrow]  ;; Caps + Cmd + F → ⌥→

                 ;; Line boundary navigation
                 [:!QWERa :!Cleft_arrow]    ;; Caps + A → ⌘←
                 [:!QWERg :!Cright_arrow]   ;; Caps + G → ⌘→

                 ;; Enter
                 [:!QWERspacebar :return_or_enter]]}

        ;; ===== Text Selection Layer ================================
        {:des   "Hyper-based text selection"
         :rules [;; Basic shift-selection
                 [:!QWERi :!Sup_arrow]       ;; Caps + I → ⇧↑
                 [:!QWERk :!Sdown_arrow]     ;; Caps + K → ⇧↓
                 [:!QWERj :!Sleft_arrow]     ;; Caps + J → ⇧←
                 [:!QWERl :!Sright_arrow]    ;; Caps + L → ⇧→

                 ;; Word selection
                 [:!QWERCj :!OSleft_arrow]   ;; Caps + Cmd + J → ⌥⇧←
                 [:!QWERCl :!OSright_arrow]  ;; Caps + Cmd + L → ⌥⇧→

                 ;; Full-line selection
                 [:!QWERh :!SCleft_arrow]          ;; Caps + H → ⌘⇧←
                 [:!QWERsemicolon :!SCright_arrow] ;; Caps + ; → ⌘⇧→
                 ]}

        ;; ===== Text Deletion Layer =================================
        {:des   "Hyper-based text deletion"
         :rules [;; Basic deletion
                 [:!QWERw :delete_or_backspace]  ;; Caps + W → ⌫
                 [:!QWERr :delete_forward]       ;; Caps + R → fn + ⌫ / forward delete

                 ;; Word deletion
                 [:!QWERCw :!Odelete_or_backspace] ;; Caps + Cmd + W → ⌥⌫
                 [:!QWERCr :!Odelete_forward]      ;; Caps + Cmd + R → ⌥ + forward delete

                 ;; Delete to beginning of line
                 [:!QWERdelete_or_backspace :!Cdelete_or_backspace]

                 ;; Position-based deletion
                 [:!QWERopen_bracket [:!SCleft_arrow :delete_or_backspace]] ;; Caps + [ → select to line start, delete
                 [:!QWERslash [:!SCright_arrow :delete_or_backspace]]       ;; Caps + / → select to line end, delete
                 ]}]}